{
  "name": "mailforge-cloudflare-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mailforge",
    "db:migrate:local": "wrangler d1 migrations apply mailforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply mailforge --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261016.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
